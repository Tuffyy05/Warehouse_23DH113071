@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Lỗi hệ thống";
}

<h1 class="text-danger">Đã có lỗi xảy ra!</h1>
<h2 class="text-danger">Yêu cầu không thể hoàn tất.</h2>

@if (Model != null)
{
    <div class="alert alert-danger mt-3">
        <p><strong>Controller:</strong> @Model.ControllerName</p>
        <p><strong>Action:</strong> @Model.ActionName</p>
        <p><strong>Chi tiết lỗi:</strong> @Model.Exception.Message</p>
    </div>
}
