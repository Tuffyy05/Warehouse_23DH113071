@model Warehouse_23DH113071.Models.SearchViewModel
@{
    ViewBag.Title = "Tìm Kiếm & Bộ Lọc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-card-modern">
    <div class="page-header-strip">
        <div>
            <h2 class="page-title-modern">TÌM KIẾM & BỘ LỌC SẢN PHẨM</h2>
            <div class="page-subtitle-modern">Câu 3: Tìm kiếm theo tên (case-insensitive), lọc trạng thái, sắp xếp đơn giá (LINQ)</div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="card p-3 mb-4 border-0" style="background: #f1f5f9; border-radius: 12px;">
        @using (Html.BeginForm("Search", "Products", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">TÊN SẢN PHẨM:</label>
                @Html.TextBoxFor(m => m.SearchName, new { @class = "form-control-modern", placeholder = "Nhập từ khóa tìm kiếm..." })
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">TRẠNG THÁI TỒN KHO:</label>
                @Html.DropDownListFor(m => m.StatusFilter, new List<SelectListItem>
                {
                    new SelectListItem { Text = "-- Tất cả trạng thái --", Value = "All" },
                    new SelectListItem { Text = "Hết hàng (SL = 0)", Value = "HetHang" },
                    new SelectListItem { Text = "Sắp hết (SL < 5)", Value = "SapHet" },
                    new SelectListItem { Text = "Đủ hàng (SL >= 5)", Value = "DuHang" }
                }, new { @class = "form-control-modern" })
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted">SẮP XẾP THEO ĐƠN GIÁ:</label>
                @Html.DropDownListFor(m => m.SortOrder, new List<SelectListItem>
                {
                    new SelectListItem { Text = "Mặc định (Theo Mã SP)", Value = "" },
                    new SelectListItem { Text = "Giá tăng dần (Thấp -> Cao)", Value = "price_asc" },
                    new SelectListItem { Text = "Giá giảm dần (Cao -> Thấp)", Value = "price_desc" }
                }, new { @class = "form-control-modern" })
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-teal w-100">Lọc</button>
                <a href="@Url.Action("Search", "Products")" class="btn-secondary-modern">Reset</a>
            </div>
        }
    </div>

    <!-- RESULT TABLE -->
    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã SP</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Danh Mục</th>
                    <th class="text-end">Đơn Giá</th>
                    <th class="text-center">Số Lượng</th>
                    <th class="text-center">Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Results.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Không tìm thấy sản phẩm nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Results)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@item.ProductID</td>
                            <td class="fw-semibold text-dark">@item.ProductName</td>
                            <td><span class="badge bg-light text-secondary border">@item.Category</span></td>
                            <td class="text-end fw-bold" style="color: #0f766e;">@item.Price.ToString("N2") đ</td>
                            <td class="text-center fw-bold fs-6">@item.Quantity</td>
                            <td class="text-center">
                                @if (item.Quantity == 0)
                                {
                                    <span class="badge-stock badge-stock-out">Hết hàng</span>
                                }
                                else if (item.Quantity < 5)
                                {
                                    <span class="badge-stock badge-stock-low">Sắp hết (@item.Quantity)</span>
                                }
                                else
                                {
                                    <span class="badge-stock badge-stock-in">Đủ hàng</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 text-muted" style="font-size: 0.85rem;">
        Tìm thấy <strong>@Model.Results.Count</strong> sản phẩm phù hợp.
    </div>
</div>
