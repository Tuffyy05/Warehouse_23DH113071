@model Warehouse_23DH113071.Models.Product
@{
    ViewBag.Title = "Chỉnh Sửa Sản Phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-card-modern">
    <div class="page-header-strip">
        <div>
            <h2 class="page-title-modern">CHỈNH SỬA THÔNG TIN SẢN PHẨM</h2>
            <div class="page-subtitle-modern">Câu 2b: Chỉ cho phép sửa Tên, Danh mục, Đơn giá (> 0). Khóa Mã SP và Số lượng.</div>
        </div>
        <div>
            <a href="@Url.Action("Index", "Products")" class="btn-secondary-modern">
                &larr; Quay lại danh sách
            </a>
        </div>
    </div>

    @using (Html.BeginForm("Edit", "Products", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ProductID)

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-modern-danger">
                <strong>Vui lòng kiểm tra lại thông tin nhập liệu:</strong>
                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0 mt-1" })
            </div>
        }

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted">Mã sản phẩm (Không thể sửa):</label>
                <input type="text" class="form-control-modern bg-light" value="@Model.ProductID" disabled readonly />
                <small class="text-muted">Mã định danh duy nhất (Khóa chính - Identity).</small>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted">Số lượng tồn kho (Không thể sửa ở đây):</label>
                <input type="text" class="form-control-modern bg-light" value="@Model.Quantity" disabled readonly />
                <small class="text-muted">Số lượng chỉ được điều chỉnh qua chức năng Kiểm kê (Câu 4 / Câu 5).</small>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Tên sản phẩm (*):</label>
            @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control-modern", placeholder = "Nhập tên sản phẩm..." })
            @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Danh mục (*):</label>
            @Html.TextBoxFor(m => m.Category, new { @class = "form-control-modern", placeholder = "Nhập danh mục sản phẩm..." })
            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold text-dark">Đơn giá (Price > 0) (*):</label>
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control-modern", type = "number", step = "0.01", placeholder = "Nhập đơn giá (> 0)..." })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-teal">
                Lưu Thay Đổi
            </button>
            <a href="@Url.Action("Index", "Products")" class="btn-secondary-modern">
                Hủy bỏ
            </a>
        </div>
    }
</div>
