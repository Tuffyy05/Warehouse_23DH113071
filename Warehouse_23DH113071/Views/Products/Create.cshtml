@model Warehouse_23DH113071.Models.Product
@{
    ViewBag.Title = "Thêm Sản Phẩm Mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-card-modern">
    <div class="page-header-strip">
        <div>
            <h2 class="page-title-modern">THÊM MỚI SẢN PHẨM VÀO KHO</h2>
            <div class="page-subtitle-modern">Câu 6: Kiểm tra tên bắt buộc, đơn giá > 0, số lượng >= 0, kiểm tra trùng tên sản phẩm (không phân biệt hoa thường)</div>
        </div>
        <div>
            <a href="@Url.Action("Index", "Products")" class="btn-secondary-modern">
                &larr; Quay lại danh sách
            </a>
        </div>
    </div>

    @using (Html.BeginForm("Create", "Products", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-modern-danger">
                <strong>Vui lòng kiểm tra lại dữ liệu nhập:</strong>
                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-0 mt-1" })
            </div>
        }

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Tên sản phẩm (*):</label>
            @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control-modern", placeholder = "Nhập tên sản phẩm..." })
            @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-dark">Danh mục (*):</label>
            @Html.TextBoxFor(m => m.Category, new { @class = "form-control-modern", placeholder = "Nhập tên danh mục..." })
            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small mt-1 d-block" })
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold text-dark">Đơn giá (Price > 0) (*):</label>
                @Html.TextBoxFor(m => m.Price, new { @class = "form-control-modern", type = "number", step = "0.01", placeholder = "Nhập đơn giá (> 0)..." })
                @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small mt-1 d-block" })
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold text-dark">Số lượng ban đầu (Quantity >= 0) (*):</label>
                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control-modern", type = "number", min = "0", placeholder = "Nhập số lượng (>= 0)..." })
                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-teal">
                + Thêm Sản Phẩm Mới
            </button>
            <a href="@Url.Action("Index", "Products")" class="btn-secondary-modern">
                Hủy bỏ
            </a>
        </div>
    }
</div>
